{
  "name": "easy-yt-playlist",
  "version": "1.0.0",
  "description": "A small firefox extension to easily add a video to multiple youtube playlists.",
  "keywords": [
    "extension",
    "firefox",
    "youtube"
  ],
  "homepage": "https://github.com/uAtomicBoolean/easy-yt-playlist#readme",
  "bugs": {
    "url": "https://github.com/uAtomicBoolean/easy-yt-playlist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uAtomicBoolean/easy-yt-playlist.git"
  },
  "license": "MIT",
  "author": "uAtomicBoolean <uatomicboolean@proton.me>",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "web-ext run --source-dir src --start-url https://www.youtube.com",
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
